{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "christmas-from-yuan-cards",
  "main": "src/index.js",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "CARDS_KV",
      "id": "bc1b3fc7bdc44d4d873c4f4dbf405f6e"
    }
  ],
  "routes": [
    {
      "pattern": "cards.konig.cc.cd",
      "custom_domain": true
    }
  ]
}
